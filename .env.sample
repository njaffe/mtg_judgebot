############################################################
# .env.sample — Example Environment Configuration
# ----------------------------------------------------------
# Copy this file to ".env" and fill in your own API keys.
# The .env file is ignored by git (see .gitignore).
############################################################

# === LLM PROVIDER ===
# Supported providers: anthropic, openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI-compatible providers (OpenAI, OpenRouter, vLLM, Ollama-compatible, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# === EXTERNAL SOURCES (optional, off by default) ===
# Set to true to enable Google/Reddit as supplementary sources
ENABLE_EXTERNAL_SOURCES=false

# Google Custom Search API (only needed if external sources enabled)
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Reddit API credentials (only needed if external sources enabled)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=mtg-judgebot/1.0

# === DATA PATHS ===
FAISS_INDEX_PATH=./data/indices
DATA_PATH=./src/data
RAW_DOCS_PATH=raw_docs

# === EMBEDDINGS ===
# Local embedding model (runs on CPU, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
