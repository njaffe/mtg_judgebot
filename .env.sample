############################################################
# .env.sample — Example Environment Configuration
# ----------------------------------------------------------
# Copy this file to ".env" and fill in your own API keys.
# The .env file is ignored by git (see .gitignore).
############################################################

# === CORE SERVICES (required) ===
# Anthropic API key (used for chat/synthesis via Claude)
ANTHROPIC_API_KEY='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'

# OpenAI API key — NO LONGER NEEDED (embeddings are now local via sentence-transformers)
# OPENAI_API_KEY=your_openai_api_key_here

# === EXTERNAL SOURCES (optional, off by default) ===
# Set to true to enable Google/Reddit as supplementary sources
ENABLE_EXTERNAL_SOURCES=false

# Google Custom Search API (only needed if external sources enabled)
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Reddit API credentials (only needed if external sources enabled)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=mtg-judgebot/1.0

# === DATA PATHS ===
# Paths used for RAG indexing and corpus storage
FAISS_INDEX_PATH=./data/indices
DATA_PATH=./data
RAW_DOCS_PATH=raw_docs

# === EMBEDDINGS ===
# Local embedding model (runs on CPU, no API key needed)
# Change only if you want a different sentence-transformers model
EMBEDDING_MODEL=all-MiniLM-L6-v2


############################################################
# === V2: LLM PROXY + REDIS (optional, for Docker-based run)
############################################################

# Toggle proxy usage (set to true for Docker / production)
USE_LLM_PROXY=true

# Default vendor/model for proxy routing
LLM_DEFAULT_VENDOR=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# Proxy URL
# Inside docker compose network:
PROXY_BASE_URL=http://proxy:8080
# For local dev (if running proxy manually):
# PROXY_BASE_URL=http://localhost:8080

# Redis (used by proxy for caching and cost tracking)
# Inside docker compose network:
REDIS_URL=redis://redis:6379/0
# Local dev (standalone redis):
# REDIS_URL=redis://localhost:6379/0

# Anthropic key for Claude models (same key as above if using proxy)
# ANTHROPIC_API_KEY=

############################################################
# End of file
############################################################