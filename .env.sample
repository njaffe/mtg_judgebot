############################################################
# .env.sample — Example Environment Configuration
# ----------------------------------------------------------
# Copy this file to ".env" and fill in your own API keys.
# The .env file is ignored by git (see .gitignore).
############################################################

# === CORE SERVICES (required) ===
# OpenAI API key (used for embeddings and synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Google Custom Search API (for external context)
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Reddit API credentials
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=mtg-judgebot/1.0

# === DATA PATHS ===
# Paths used for RAG indexing and corpus storage
FAISS_INDEX_PATH=./data/indices
DATA_PATH=./data
RAW_DOCS_PATH=raw_docs

# === EMBEDDINGS ===
# Model used for embedding generation
EMBEDDING_MODEL=text-embedding-ada-002


############################################################
# === V2: LLM PROXY + REDIS (optional, for Docker-based run)
############################################################

# Toggle proxy usage (set to true for Docker / production)
USE_LLM_PROXY=true

# Default vendor/model for proxy routing
LLM_DEFAULT_VENDOR=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# Proxy URL
# Inside docker compose network:
PROXY_BASE_URL=http://proxy:8080
# For local dev (if running proxy manually):
# PROXY_BASE_URL=http://localhost:8080

# Redis (used by proxy for caching and cost tracking)
# Inside docker compose network:
REDIS_URL=redis://redis:6379/0
# Local dev (standalone redis):
# REDIS_URL=redis://localhost:6379/0

# Optional Anthropic key (if you want to enable Claude models)
ANTHROPIC_API_KEY=

############################################################
# End of file
############################################################